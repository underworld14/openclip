node_modules
dist
out
*.log
.DS_Store

# build & tooling caches
.eslintcache
.vite
coverage
test-results
playwright-report
*.tsbuildinfo

# generated test fixtures (synthetic media, never committed — PRD §18)
tests/fixtures/.generated

# media de-risk smoke cache (real GGML model + media, NEVER committed — PRD §13/§18)
.smoke-cache/

# stray model weights / media binaries anywhere (PRD §13: models downloaded on demand)
*.bin
*.mp4
*.wav
*.mov
*.aiff
# …but DO keep the bundled libre caption font (PRD §6.4 / §20)
!build/fonts/*.ttf

# auto-reframe ONNX runtime (Part J): the onnxruntime-web WASM + loader are LARGE
# and copied at build time from node_modules by scripts/bundle-binaries.mjs — NOT
# committed. The small YuNet model (face_detection_yunet_2023mar.onnx) + SOURCES.md
# ARE committed (see build/onnx/SOURCES.md).
build/onnx/*.wasm
build/onnx/*.mjs

# bundled native sidecars — copied at build time by scripts/bundle-binaries.mjs,
# NEVER committed (large; reproducible from node_modules + the whisper build — P7/§13)
resources/ffmpeg/
resources/whisper/
resources/yt-dlp/
# local whisper.cpp build output + yt-dlp download cache staged for the bundler
build/whisper-build/
build/yt-dlp-cache/

# secrets / local env
.env
.env.*
!.env.example

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
